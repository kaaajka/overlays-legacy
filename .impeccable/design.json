      "css": ".ds-information-specimen{width:372px;height:100px;position:relative}.ds-information-card{position:absolute;left:0;top:0;width:1240px;box-sizing:border-box;padding:42px 48px;background:rgba(9,12,18,.87);border-radius:14px;box-shadow:0 18px 60px rgba(0,0,0,.25);color:#fff;font-family:Poppins,sans-serif;transform:scale(.3);transform-origin:top left}.ds-information-header{display:flex;justify-content:space-between;align-items:baseline;gap:35px;padding-bottom:22px;color:#fff4d0;font-size:40px;line-height:1.25}.ds-information-donor{font-weight:600;overflow-wrap:anywhere;min-width:0}.ds-information-amount{flex-shrink:0;font-weight:500}.ds-information-message{font-size:32px;line-height:1.6;max-height:405px;overflow:hidden;white-space:pre-wrap;overflow-wrap:anywhere}"
